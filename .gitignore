# Dependencies
node_modules/

# Local secrets — the single source of truth. NEVER commit. Only the template ships.
.env
.env.*
!.env.example

# Build output — regenerated by `npm run build`; secrets get inlined here (P4),
# so the built bundle must never be committed.
dist/
build/

# Scanner reports (regenerate locally / in CI)
Reports/
*.sarif

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

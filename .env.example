# Copy to .env and fill in real values. .env is gitignored and never committed.
# Placeholders below are intentionally NOT secret-shaped so this template stays
# clean under gitleaks / trufflehog / GitGuardian.
#
# VITE_* values are inlined into the built bundle at build time (path P4).
# The remaining values are read by server.js at runtime (path P7 / auth).

# P4 — front-end / SDK secrets (build-injected)
VITE_STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
VITE_STRIPE_SECRET_KEY=<stripe-secret-key>
VITE_SENDGRID_API_KEY=<sendgrid-api-key>
VITE_SENDGRID_FROM=noreply@example.com
VITE_AWS_REGION=us-east-1
VITE_AWS_ACCESS_KEY_ID=<aws-access-key-id>
VITE_AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
VITE_S3_BUCKET=<s3-bucket-name>
VITE_TWILIO_ACCOUNT_SID=<twilio-account-sid>
VITE_TWILIO_AUTH_TOKEN=<twilio-auth-token>
VITE_TWILIO_FROM_NUMBER=<twilio-from-number>
VITE_INTERNAL_API_KEY=<internal-api-key>
VITE_WEBHOOK_SECRET=<webhook-secret>
VITE_FIREBASE_API_KEY=<firebase-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://<project>-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project>.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
VITE_FIREBASE_APP_ID=<firebase-app-id>
VITE_FIREBASE_MEASUREMENT_ID=<measurement-id>
VITE_FIREBASE_PRIVATE_KEY_ID=<private-key-id>
VITE_FIREBASE_PRIVATE_KEY=<pem-private-key-with-\n-escapes>
VITE_FIREBASE_CLIENT_EMAIL=<service-account-email>
VITE_FIREBASE_CLIENT_ID=<service-account-client-id>
VITE_AZURE_TENANT_ID=<tenant-guid>
VITE_AZURE_APP_ID=<app-client-id-guid>
VITE_AZURE_APP_KEY=<azure-app-client-secret>
VITE_AZURE_RESOURCE_ID=https://<api-host>
VITE_AZURE_RESOURCE_KEY=<azure-resource-key>
VITE_APIM_SUBSCRIPTION_KEY=<apim-subscription-key>
VITE_SERVICE_ACCOUNT_KEY=<internal-service-key>
VITE_MIXPANEL_TOKEN=<mixpanel-token>
VITE_SP_ENCRYPTED_CONFIG=<cryptojs-aes-blob>
VITE_SP_CONFIG_KEY=<sp-config-decrypt-key>
VITE_CDN_API_KEY=<cdn-api-key>

# P7 — runtime config.json (server-generated)
AZURE_TENANT_ID=<tenant-guid>
AZURE_CLIENT_ID=<app-client-id-guid>
AZURE_CLIENT_SECRET=<azure-app-client-secret>
AZURE_AUTHORITY=https://login.microsoftonline.com/<tenant-guid>
AZURE_SCOPE=https://<api-host>/.default
AZURE_REDIRECT_URI=https://<portal-host>/auth/callback
RUNTIME_APIM_SUBSCRIPTION_KEY=<apim-subscription-key>
STORAGE_CONNECTION_STRING=<azure-storage-connection-string>
STORAGE_CONTAINER=policy-documents
REDIS_URL=redis://:<password>@<cache-host>:6379

# Functional server secrets
JWT_SECRET=<jwt-signing-secret>
APIM_KEY=<apim-subscription-key>
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=<admin-password>
DB_CONN_STR=<sql-connection-string>
AAD_APP_ID=<app-client-id-guid>
AAD_APP_KEY=<azure-app-client-secret>
AAD_RESOURCE_KEY=<azure-resource-key>
AAD_ADMIN_APP_ID=<admin-app-client-id-guid>
AAD_ADMIN_APP_KEY=<admin-app-client-secret>
AAD_ADMIN_RESOURCE_KEY=<admin-resource-key>
WS_INTERNAL_KEY=<websocket-internal-key>
HTML_COMMENT_DB_PASSWORD=<legacy-db-password>
